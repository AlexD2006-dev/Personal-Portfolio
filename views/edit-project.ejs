<!doctype html>
<html lang="en-US">
  <%- include('partials/header', { title: 'Edit Project' }) %>
  <body>
    <%- include('partials/nav') %>

    <h1>Edit Project</h1>

    <form action="/project/<%= project.slug %>/edit" method="POST">
      <label>Name: <input type="text" name="name" value="<%= project.name %>" required /></label><br/>
      <label>Slug: <input type="text" name="slug" value="<%= project.slug %>" required /></label><br/>
      <label>Description: <textarea name="description" required><%= project.description %></textarea></label><br/>
      <label>Image: <input type="text" name="image" value="<%= project.image %>" /></label><br/>
      <button type="submit">Save Changes</button>
    </form>

    <a href="/projects">← Back to Projects</a>
  </body>
</html>
