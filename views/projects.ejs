<!doctype html>
<html lang="en-US">
  <%- include('partials/header', { title: 'Projects' }) %>
  <body>
    <%- include('partials/nav') %>

    <h1>Alex Draesner: Portfolio</h1>
    <img src="/3d-pager.png" alt="My 3d Print" />
    
    <h1>My Projects</h1>

    <section id="projects-list">
      <ul>
        <% if (projects.length === 0) { %>
          <li><p>No projects yet.</p></li>
        <% } else { %>
          <% projects.forEach(function(project) { %>
            <li>
              <h2><a href="/project/<%= project.slug %>"><%= project.name %></a></h2>
              <p><%= project.description %></p>
              <a href="/project/<%= project.slug %>/edit">Edit</a> |
              <form action="/project/<%= project.slug %>/delete" method="POST" style="display:inline;">
                <button type="submit">Delete</button>
              </form>
            </li>
          <% }) %>
        <% } %>
      </ul>
    </section>

    <a href="/projects/new">+ Add New Project</a>

  </body>
</html>

